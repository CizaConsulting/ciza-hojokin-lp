# Formspree等のフォーム送信先URLを設定
# 例: https://formspree.io/f/xxxxxxxx
PUBLIC_CONTACT_FORM_ENDPOINT=

# Google Analytics 4 の測定ID（未設定ならタグは出力されない）
# 例: G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=

# Search Console のHTMLタグ確認で表示される content の値のみ（未設定ならメタタグは出力されない）
# 例: abcdEFGH1234567890ijklMNOP_qrstuvwxyz
PUBLIC_GOOGLE_SITE_VERIFICATION=
