---
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, canonical, noindex = false, schema } = Astro.props;
const siteTitle = 'CIZA 補助金・支援制度ナビ';
const pageTitle = title === siteTitle ? title : `${title}｜${siteTitle}`;
const siteUrl = new URL('/', Astro.site ?? Astro.url).href;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const organizationId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;
const personUrl = new URL('/author/takuma-kawahara/', siteUrl).href;
const personImage = new URL('/images/takuma-kawahara.jpg', siteUrl).href;
const extraSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: '株式会社シザコンサルティング',
      alternateName: 'CIZA Consulting',
      url: 'https://www.ciza.co.jp/',
      email: 'info@ciza.co.jp',
      telephone: '06-6476-9777',
      foundingDate: '2012-10-17',
      description: '補助金、財務、融資、事業計画、経営管理を横断して中小企業の投資と成長を支援するコンサルティング会社です。',
      sameAs: [
        'https://www.ciza.co.jp/',
        'https://www.youtube.com/@takuma_kawahara',
        'https://keieikanri.ciza.co.jp/'
      ],
      address: {
        '@type': 'PostalAddress',
        postalCode: '532-0011',
        addressRegion: '大阪府',
        addressLocality: '大阪市淀川区',
        streetAddress: '西中島1丁目9番20号 新中島ビル9階',
        addressCountry: 'JP'
      }
    },
    {
      '@type': 'Person',
      '@id': `${personUrl}#person`,
      name: '川原 拓馬',
      jobTitle: '代表取締役・経営コンサルタント',
      url: personUrl,
      image: personImage,
      worksFor: { '@id': organizationId },
      alumniOf: { '@type': 'CollegeOrUniversity', name: '神戸大学経営学部' },
      sameAs: [
        'https://www.youtube.com/@takuma_kawahara',
        'https://www.ciza.co.jp/greeting.html',
        'https://keieikanri.ciza.co.jp/about'
      ],
      knowsAbout: [
        '補助金', 'ものづくり補助金', '成長加速化補助金', '事業再構築補助金',
        '省力化投資補助金', '事業承継・M&A補助金', '小規模事業者持続化補助金',
        'IT導入補助金', '財務', '資金調達', '事業計画', '経営管理', '中小企業支援'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: siteTitle,
      publisher: { '@id': organizationId },
      inLanguage: 'ja-JP'
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': organizationId },
      inLanguage: 'ja-JP'
    },
    ...extraSchema
  ]
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="株式会社シザコンサルティング／川原 拓馬" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">CIZA 支援制度ナビ<small>株式会社シザコンサルティング</small></a>
        <nav class="nav" aria-label="メインナビゲーション">
          <a href="/equipment-investment/">設備投資</a>
          <a href="/new-business/">新規事業</a>
          <a href="/about/">運営会社</a>
          <a href="/consultation/" class="button small">30分無料Web診断</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>株式会社シザコンサルティング</strong><br />
          補助金・財務・資金調達・経営管理を横断して支援
          <div class="footer-links">
            <a href="/about/">運営会社</a>
            <a href="/author/takuma-kawahara/">代表者・著者</a>
            <a href="/editorial-policy/">編集方針</a>
            <a href="/privacy/">プライバシーポリシー</a>
            <a href="/consultation/">30分無料Web診断</a>
            <a href="mailto:info@ciza.co.jp">info@ciza.co.jp</a>
          </div>
        </div>
        <div>© CIZA Consulting Inc.</div>
      </div>
    </footer>
  </body>
</html>
