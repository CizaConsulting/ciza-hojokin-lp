---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const newsPosts = posts.filter(
  (post) => post.data.contentType === '補助金ニュース' || post.data.category === '制度情報',
);
const practicalPosts = posts.filter((post) => !newsPosts.includes(post));

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---
<BaseLayout title="補助金・支援制度の記事一覧" description="補助金の申請実務を解説する実務ガイドと、政府・自治体の一次情報に基づく補助金ニュースを分けて掲載しています。">
  <div class="page-hero">
    <div class="container prose">
      <p class="eyebrow">補助金・支援制度の実務情報</p>
      <h1>記事一覧</h1>
      <p class="lead">長く使える申請実務の解説と、期限や制度変更を伝える最新ニュースを分けて確認できます。</p>
      <nav class="content-switch" aria-label="記事カテゴリ">
        <a href="#practical-guides">実務ガイド <span>{practicalPosts.length}</span></a>
        <a href="#subsidy-news">補助金ニュース <span>{newsPosts.length}</span></a>
      </nav>
    </div>
  </div>

  <section class="section content-section" id="practical-guides">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EVERGREEN</p>
          <h2>実務ガイド</h2>
        </div>
        <p>申請前の判断、資金繰り、発注時期、事業計画の作り方など、制度が変わっても役立つ考え方を解説します。</p>
      </div>

      {practicalPosts.length > 0 ? (
        <div class="blog-grid">
          {practicalPosts.map((post) => (
            <article class="blog-card">
              <div class="blog-meta">
                <span>{post.data.category}</span>
                <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
              </div>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <a class="text-link" href={`/blog/${post.id}/`}>記事を読む →</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="notice">現在、最初の実務ガイドを準備しています。</div>
      )}
    </div>
  </section>

  <section class="section content-section news-section" id="subsidy-news">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">LATEST UPDATES</p>
          <h2>補助金ニュース</h2>
        </div>
        <p>政府・自治体・補助金事務局の一次情報から、締切や対象条件など企業の行動に影響する更新だけを掲載します。</p>
      </div>

      {newsPosts.length > 0 ? (
        <div class="blog-grid">
          {newsPosts.map((post) => (
            <article class="blog-card news-card">
              <div class="blog-meta">
                <span>補助金ニュース</span>
                <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
              </div>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              {post.data.officialCheckedAt && (
                <p class="checked-date">公式情報確認日：{formatDate(post.data.officialCheckedAt)}</p>
              )}
              <a class="text-link" href={`/blog/${post.id}/`}>ニュースを読む →</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="notice">重要な制度変更や公募情報が確認できたときに掲載します。</div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .content-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .content-switch a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border, #d7dde5);
    border-radius: 999px;
    background: #fff;
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  .content-switch span {
    display: inline-grid;
    min-width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border-radius: 999px;
    background: #eef2f6;
    font-size: 0.82rem;
  }

  .content-section {
    scroll-margin-top: 5rem;
  }

  .news-section {
    background: #f7f9fb;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(280px, 1.2fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin: 0.25rem 0 0;
  }

  .section-heading > p {
    margin: 0;
    max-width: 46rem;
  }

  .blog-card h3 {
    margin-top: 0.75rem;
  }

  .news-card {
    border-top: 3px solid #365f7d;
  }

  .checked-date {
    margin-top: 0.8rem;
    font-size: 0.86rem;
    color: #5d6874;
  }

  @media (max-width: 720px) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
